# Local SQLite database. The default keeps the database in the backend directory.
PRICEWATCH_DATABASE_URL=sqlite:///./pricewatch.db

# Automatic updates run no more often than once a day; the minimum is one hour.
PRICEWATCH_UPDATE_INTERVAL_SECONDS=86400

# Minimum interval between requests to the same store (60 seconds by default).
PRICEWATCH_MIN_REQUEST_INTERVAL_SECONDS=60
